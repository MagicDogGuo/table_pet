<Window x:Class="TablePet.Ui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Table Pet Settings"
        Width="320"
        Height="220"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <StackPanel Margin="16">
        <CheckBox x:Name="ReminderEnabled"
                  Content="Water reminder"
                  Margin="0,0,0,12"/>
        <TextBlock Text="Interval (minutes)"/>
        <DockPanel Margin="0,4,0,12">
            <TextBlock x:Name="IntervalLabel" DockPanel.Dock="Right" Width="36" TextAlignment="Right"/>
            <Slider x:Name="IntervalSlider"
                    TickFrequency="1"
                    IsSnapToTickEnabled="True"
                    ValueChanged="IntervalSlider_ValueChanged"/>
        </DockPanel>
        <CheckBox x:Name="ClickThrough"
                  Content="Click-through when idle"
                  Margin="0,0,0,16"/>
        <Button Content="Save"
                Width="80"
                HorizontalAlignment="Right"
                IsDefault="True"
                Click="Save_Click"/>
    </StackPanel>
</Window>
