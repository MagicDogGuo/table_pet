<Window x:Class="TablePet.Ui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="桌寵設定"
        Icon="pack://application:,,,/Assets/App.ico"
        Width="320"
        Height="220"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <StackPanel Margin="16">
        <CheckBox x:Name="ReminderEnabled"
                  Content="喝水提醒"
                  Margin="0,0,0,12"/>
        <TextBlock Text="間隔（分鐘）"/>
        <DockPanel Margin="0,4,0,12">
            <TextBlock x:Name="IntervalLabel" DockPanel.Dock="Right" Width="36" TextAlignment="Right"/>
            <Slider x:Name="IntervalSlider"
                    TickFrequency="1"
                    IsSnapToTickEnabled="True"
                    ValueChanged="IntervalSlider_ValueChanged"/>
        </DockPanel>
        <CheckBox x:Name="ClickThrough"
                  Content="待機時滑鼠穿透"
                  Margin="0,0,0,16"/>
        <Button Content="儲存"
                Width="80"
                HorizontalAlignment="Right"
                IsDefault="True"
                Click="Save_Click"/>
    </StackPanel>
</Window>
